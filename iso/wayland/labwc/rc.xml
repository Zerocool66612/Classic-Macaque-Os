<?xml version="1.0"?>
<labwc_config>
 <core><decoration>server</decoration><gap>0</gap><xwaylandPersistence>no</xwaylandPersistence></core>
 <theme><name>Macaque Platinum</name><cornerRadius>2</cornerRadius><titlebar><layout>close,iconify,max:menu</layout></titlebar><font name="DejaVu Sans" size="10" /></theme>
 <keyboard>
  <default />
  <keybind key="C-A-t"><action name="Execute" command="/usr/local/bin/macaque-action terminal" /></keybind>
  <keybind key="C-A-l"><action name="Execute" command="/usr/local/bin/macaque-lock" /></keybind>
  <keybind key="XF86AudioLowerVolume"><action name="Execute" command="/usr/local/bin/macaque-action volume-down" /></keybind>
  <keybind key="XF86AudioRaiseVolume"><action name="Execute" command="/usr/local/bin/macaque-action volume-up" /></keybind>
  <keybind key="XF86AudioMute"><action name="Execute" command="/usr/local/bin/macaque-action mute" /></keybind>
  <keybind key="XF86AudioMicMute"><action name="Execute" command="/usr/local/bin/macaque-action mic-mute" /></keybind>
  <keybind key="XF86MonBrightnessDown"><action name="Execute" command="/usr/local/bin/macaque-action brightness-down" /></keybind>
  <keybind key="XF86MonBrightnessUp"><action name="Execute" command="/usr/local/bin/macaque-action brightness-up" /></keybind>
  <keybind key="Print"><action name="Execute" command="/usr/local/bin/macaque-action screenshot" /></keybind>
  <keybind key="S-Print"><action name="Execute" command="/usr/local/bin/macaque-action screenshot-region" /></keybind>
  <keybind key="C-Print"><action name="Execute" command="/usr/local/bin/macaque-action screenshot-full" /></keybind>
 </keyboard>
 <mouse><default /></mouse>
 <windowRules>
  <windowRule identifier="org.macaque.Classic" serverDecoration="no">
   
   <action name="Maximize" /><action name="ToggleAlwaysOnBottom" />
  </windowRule>
 </windowRules>
</labwc_config>
