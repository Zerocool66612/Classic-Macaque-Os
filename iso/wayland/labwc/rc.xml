<?xml version="1.0"?>
<labwc_config>
 <core><decoration>server</decoration><gap>0</gap><xwaylandPersistence>no</xwaylandPersistence></core>
 <theme><name>Macaque Platinum</name><cornerRadius>2</cornerRadius><titlebar><layout>close,iconify,max:menu</layout></titlebar><font name="DejaVu Sans" size="10" /></theme>
 <keyboard>
  <default />
  <keybind key="C-A-t"><action name="Execute" command="/usr/local/bin/macaque-action terminal" /></keybind>
  <keybind key="C-A-l"><action name="Execute" command="/usr/local/bin/macaque-lock" /></keybind>
 </keyboard>
 <mouse><default /></mouse>
 <windowRules>
  <windowRule identifier="org.macaque.Classic" serverDecoration="no">
   
   <action name="Maximize" /><action name="ToggleAlwaysOnBottom" />
  </windowRule>
 </windowRules>
</labwc_config>
