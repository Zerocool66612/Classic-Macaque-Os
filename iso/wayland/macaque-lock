#!/bin/sh
set -eu
[ "${XDG_SESSION_TYPE:-}" = wayland ] && [ -n "${WAYLAND_DISPLAY:-}" ] || { echo 'A native Wayland session is required.' >&2; exit 1; }
# gtklock uses ext-session-lock and PAM, retaining the existing user session.
# Its GTK entry/card replaces swaylock's circular indicator on wake.
if command -v gtklock >/dev/null 2>&1; then
  exec gtklock --daemonize --style /usr/share/macaque/gtklock.css
fi
# Safe fallback for older installs lacking gtklock; never show an unsecured screen.
exec swaylock -f -c 7895a9 -i /usr/share/backgrounds/macaque-login.png \
  --indicator-radius 85 --indicator-thickness 8 \
  --inside-color ecececee --ring-color 5c7790ff \
  --text-color 20242aff --key-hl-color 3b9cdbff
