#!/bin/sh
set -eu
if [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ]; then exec dbus-run-session -- "$0"; fi
export MACAQUE_NATIVE_SESSION=1 MACAQUE_WAYLAND_SESSION=1
export XDG_SESSION_TYPE=wayland XDG_SESSION_DESKTOP=macaque
export XDG_CURRENT_DESKTOP=Macaque:wlroots
export QT_QPA_PLATFORM=wayland GDK_BACKEND=wayland SDL_VIDEODRIVER=wayland
export GTK_USE_PORTAL=1 QT_QPA_PLATFORMTHEME=
# Debian's labwc package includes XWayland, but this session never starts its
# server or supplies an X display to clients. No automatic X11 fallback.
export WLR_XWAYLAND=/usr/bin/false
unset DISPLAY XAUTHORITY QT_PLUGIN_PATH QT_QPA_PLATFORM_PLUGIN_PATH
if [ "${MACAQUE_NESTED_WAYLAND:-0}" != 1 ]; then unset WAYLAND_DISPLAY; fi
mkdir -p "$HOME/.local/state/macaque"
config_dir=/etc/xdg/macaque/labwc
if [ -f /opt/macaque-classic/input_settings.py ]; then
 if generated_dir=$(/usr/bin/python3 /opt/macaque-classic/input_settings.py --render "$config_dir/rc.xml"); then
  config_dir=$generated_dir
 else
  echo "Touchpad preferences could not be generated; using the system compositor configuration." >&2
 fi
fi
exec labwc -C "$config_dir" -S '/usr/bin/python3 /opt/macaque-classic/wayland_session.py' >> "$HOME/.local/state/macaque/compositor.log" 2>&1
